{
  "displayPicture": "~/git-repos/personal/이미지/바탕화면/afx8.jpg",
  "clockFormat": "hh:mm",
  "pillTopMargin": 2,
  "pillBottomMargin": 22,
  "textFontFamily": "Monocraft",
  "nerdFontFamily": "JetBrainsMono Nerd Font Propo",
  "timerPresets": [1, 5, 10, 15, 30],
  "mediaPopupDuration": 2000,
  "maxWorkspaces": 5,
  "notificationDisplayTime": 1000,
  "maxNotificationsInStack": 5,
  "bandwidthRefreshInterval": 300000,
  "screenLockAppCommand": "hyprlock",
  "osdDuration": 800,
  "weatherLocation": "Seoul",
  "weatherUnits": "metric",
  "weatherRefreshInterval": 3600000,
  "avoidDuplicateNotifications": true,
  "defaultTerminal": "kitty",
  "pillScale": 1.0,
  "wallpapersDir": "~/git-repos/personal/이미지/바탕화면",
  "wsCloseOnWallpaperSet": true
}
